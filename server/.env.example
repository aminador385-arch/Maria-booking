# ═══ وضع التشغيل ═══
MARIA_MODE=mock              # mock | live  (live = نداء المزوّدين الحقيقيين)
PORT=4173
PUBLIC_BASE_URL=http://localhost:4173

# ═══ قاعدة البيانات ═══
# اتركه فارغًا لاستخدام PGlite (Postgres داخل العملية — تطوير)
# للإنتاج ضع سلسلة اتصال Postgres:
# DATABASE_URL=postgres://user:pass@host:5432/maria
DATABASE_URL=
PGLITE_DIR=./data/pglite

# ═══ المدفوعات ═══
PAYMENT_PROVIDER=sandbox     # sandbox | stripe | chargily | none (وضع الإحالة بلا استلام أموال)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Chargily (الجزائر: CIB / EDAHABIA / SATIM) — الدفع بالدينار
CHARGILY_SECRET_KEY=
CHARGILY_WEBHOOK_SECRET=
CHARGILY_TEST=true
CHARGILY_METHOD=edahabia            # edahabia | cib | chargily_app
CHARGILY_FEES_ALLOCATION=merchant   # merchant | customer | split
# ملاحظة: توقيع Webhook Chargily يُحسب بمفتاح CHARGILY_SECRET_KEY نفسه (لا سرّ منفصل)
DZD_PER_USD=135

# ═══ المزوّدون ═══
DUFFEL_API_KEY=
DUFFEL_VERSION=v2
# DUFFEL_BASE_URL=http://127.0.0.1:4555   # لتجربة كود Duffel مع المحاكي المحلي
VIATOR_API_KEY=

# ═══ الإدارة والشركاء ═══
MARIA_PLATFORM_CODE=MARIA
MARIA_ADMIN_TOKEN=dev-admin-token
MARIA_AUTO_APPROVE=true      # false = كل شريك جديد ينتظر مراجعة KYC

# ═══ الحساب البريدي CCP — مكان استلام العمولة ═══
# رقم الحساب (10 أرقام) + المفتاح (رقمان) أو RIP كامل من 20 رقمًا
MARIA_CCP_NUMBER=
MARIA_CCP_KEY=
MARIA_CCP_HOLDER=
MARIA_CCP_AGENCY=
PAYOUT_CHANNEL=ccp           # ccp | bank | payoneer

# ═══ الهوية القانونية (تُطبع على الفواتير) ═══
MARIA_LEGAL_NAME=
MARIA_RC_NUMBER=            # رقم السجل التجاري
MARIA_NIF=                  # رقم التعريف الجبائي
MARIA_AI=                   # رقم المادة الجبائية (إن وُجد)
MARIA_LEGAL_ADDRESS=
MARIA_LEGAL_PHONE=
MARIA_LEGAL_EMAIL=
MARIA_VAT=false             # true = مرتّب على الرسم على القيمة المضافة
MARIA_VAT_RATE=19

# ═══ البريد (إشعارات الحجز والفاتورة والتحويلات) ═══
MAIL_PROVIDER=console        # console (تطوير: يطبع فقط) | resend | brevo | off
MAIL_API_KEY=                # مفتاح Resend أو Brevo
MAIL_FROM=ماريا <no-reply@نطاقك>
MAIL_REPLY_TO=contact@نطاقك

# ═══ طريقة الحجز ═══
BOOKING_MODE=request          # request = العميل يطلب ونؤكّد (مستحسن) | instant = دفع فوري
REQUEST_TTL_HOURS=48          # مدة الرد على الطلب قبل إغلاقه تلقائيًا
ADMIN_EMAIL=                  # بريدك: يصلك تنبيه بكل طلب حجز جديد
